# GEMINI_API_KEY: Server-side key used by the Express API routes (api/app.ts)
# to call the Gemini API. Without it, those routes fall back to simulated
# responses. Set this in Vercel under Project Settings -> Environment Variables.
GEMINI_API_KEY=

# SUPABASE: Client-side config (must be prefixed with VITE_ to be exposed to
# the frontend build). Set both in Vercel under Project Settings ->
# Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=