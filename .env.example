# GEMINI_API_KEY: Server-side key used by the Express API routes (server/app.ts)
# to call the Gemini API. Without it, AI routes return an explicit unavailable
# response. Set this in Vercel under Project Settings -> Environment Variables.
GEMINI_API_KEY=
AI_ENABLED=true
GEMINI_MODEL=gemini-3.6-flash
# Optional per-operation overrides. Leave blank to inherit GEMINI_MODEL.
GEMINI_MODEL_ANALYTICS=
GEMINI_MODEL_TASK_EXTRACTION=
GEMINI_MODEL_DOCUMENT_CHAT=
GEMINI_MODEL_MEETING_SUMMARY=
AI_HEALTH_TIMEOUT_MS=10000
AI_HEALTH_CACHE_TTL_MS=300000

# Distributed per-user, per-route AI budgets. Enforced atomically by the
# reserve_ai_quota() RPC; safe defaults are used when omitted.
AI_REQUESTS_PER_HOUR=20
AI_INPUT_CHARS_PER_DAY=500000
AI_TIMEOUT_MS=30000

# SUPABASE: Client-side config (must be prefixed with VITE_ to be exposed to
# the frontend build). Set both in Vercel under Project Settings ->
# Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SECRET_KEY: modern server-only secret key (sb_secret_...). The
# legacy SUPABASE_SERVICE_ROLE_KEY is also supported as a fallback. Never use
# a VITE_ prefix or expose either value to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Must be present in Supabase Auth -> URL Configuration -> Redirect URLs.
# Dedicated first-access route. Add this exact URL to Supabase Auth redirect URLs.
AUTH_INVITE_REDIRECT_URL=http://localhost:3000/auth/setup-password
